@using IlmAcademy.ViewModels
@model PagesViewModel
@{
    ViewBag.Title = "Privacy Policy - ILM Academy";
    ViewBag.MetaDescription = "Privacy Policy of ILM Academy – Learn how we collect, use, and protect your personal information.";
    ViewBag.MetaKeywords = "ILM Academy Privacy Policy, Data Protection, Personal Information, English Courses";
    ViewBag.OgImage = "/assets/images/ilm-academy-blog.jpg";
}
<div class="site-wrapper-reveal">
    <div class="breadcrumb-area" style="background:url(@PagesViewModel.ContentUrl/@Model.ContentTypeSlug?.ImageSource) no-repeat top; background-size:cover; z-index:2">
        <div class="slider-mask"></div>
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb_box text-center">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <section class="pt-lg-5 pb-lg-5 pt-4 pb-4 bg-light-subtle">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 pe-lg-5">

                    <div class="privacy-policy-content fs-5">

                        <h2 class="mb-4">Privacy Policy</h2>
                        <p><strong>Effective Date:</strong> July 29, 2025</p>

                        <p>
                            Welcome to ILM Academy. We value your privacy and are committed to protecting your personal
                            information. This Privacy Policy outlines how we collect, use, disclose, and protect your data
                            when you visit our website <strong>https://ilmacademybangalore.com</strong> or interact with us
                            through our advertisements and services.
                        </p>

                        <h4 class="mt-4">1. Information We Collect</h4>
                        <p>We may collect the following types of personal information when you:</p>
                        <ul>
                            <li>Fill out a lead form or contact form</li>
                            <li>Register for a course or service</li>
                            <li>Subscribe to our newsletter</li>
                            <li>Interact with us on social media or through online ads</li>
                        </ul>

                        <p>Types of data collected may include:</p>
                        <ul>
                            <li>Full name</li>
                            <li>Email address</li>
                            <li>Phone number</li>
                            <li>Country of residence</li>
                            <li>Preferred course or area of interest</li>
                            <li>Any additional information voluntarily provided by you</li>
                        </ul>

                        <h4 class="mt-4">2. How We Use Your Information</h4>
                        <ul>
                            <li>Respond to your inquiries and requests</li>
                            <li>Provide details about our English language courses</li>
                            <li>Contact you regarding admission, enrollment, or class schedules</li>
                            <li>Send updates about our programs, offers, and academy news</li>
                            <li>Improve our website and advertising campaigns</li>
                        </ul>

                        <p>
                            We may also use this information to contact you via phone, WhatsApp, SMS, or email.
                        </p>

                        <h4 class="mt-4">3. Sharing of Information</h4>
                        <p>We do not sell, rent, or trade your personal information. However, we may share your data with:</p>
                        <ul>
                            <li>Internal staff or authorized partners who assist in admission or consultation</li>
                            <li>Legal authorities when required by law or to protect our rights</li>
                        </ul>

                        <h4 class="mt-4">4. Your Rights</h4>
                        <ul>
                            <li>Request access to the personal data we hold about you</li>
                            <li>Request correction or deletion of your personal data</li>
                            <li>Withdraw your consent at any time by contacting us</li>
                        </ul>

                        <h4 class="mt-4">5. Data Security</h4>
                        <p>
                            We implement appropriate technical and organizational measures to protect your personal
                            information from unauthorized access, misuse, or disclosure.
                        </p>

                        <h4 class="mt-4">6. Cookies and Tracking</h4>
                        <p>
                            Our website may use cookies or similar technologies to improve user experience and track site
                            usage. You can control cookie settings through your browser preferences.
                        </p>

                        <h4 class="mt-4">7. Third-Party Links</h4>
                        <p>
                            Our website may contain links to external websites. ILM Academy is not responsible for the privacy
                            practices of those sites.
                        </p>

                        <h4 class="mt-4">8. Policy Updates</h4>
                        <p>
                            We may update this Privacy Policy from time to time. Any changes will be posted on this page with
                            an updated revision date.
                        </p>

                        <h4 class="mt-4">9. Contact Us</h4>
                        <p>If you have any questions or requests regarding this Privacy Policy, you may contact us:</p>

                        <p>
                            <strong>ILM Academy</strong><br />
                            Website: https://ilmacademybangalore.com<br />
                            Email: ilmacademy20@gmail.com<br />
                            Phone: +91-99012 96403<br />
                            Address: Bengaluru, India
                        </p>

                    </div>
                </div>

            </div>
        </div>
    </section>
</div>
